# ==========================================
# KnowledgeVault AI — Environment Configuration
# ==========================================

# Application Environment
APP_NAME="KnowledgeVault AI"
APP_VERSION="1.0.0"
DEBUG=false

# Database Configuration
# Local SQLite default (Zero-dependency):
DATABASE_URL="sqlite:///./data/knowledgevault.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://knowledgevault:vault_secret_password@localhost:5432/knowledgevault"

# Vector Store (Qdrant)
# Leave empty for embedded local persistent storage, or specify Qdrant HTTP server:
QDRANT_URL=""
# QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="knowledgevault_chunks"

# Embedding Model
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_DIMENSION=384

# Document Ingestion & Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=50

# Retrieval & Hybrid Search
TOP_K=5
CANDIDATE_K=20
RRF_K=60
SIMILARITY_THRESHOLD=0.20
RERANKING_ENABLED=false
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# LLM Provider Configuration
# Supported options: mock, openai, anthropic, gemini, ollama
LLM_PROVIDER="mock"
LLM_MODEL="mock-expert-v1"
LLM_API_KEY=""
LLM_API_BASE=""
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Security & CORS
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'
